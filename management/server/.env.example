# MarketSuite management backend — copy to .env and fill in. NEVER commit the real .env.

# MongoDB connection string (Atlas). Required in production; dev falls back to local MongoDB.
MONGO_URI=
# Random string, at least 32 characters in production (the server refuses to start otherwise).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (portal and Store). The Store dev server proxies /api, so it needs no
# entry in development; when the Store is deployed on its OWN domain add that origin here (e.g. https://shop.example.com),
# otherwise browsers block its calls to /api/public/*. Production with none set = same-origin only.
CORS_ORIGIN=

# Set to 1 behind a reverse proxy (Render/Railway/Nginx) so rate limits see the real client IP.
TRUST_PROXY=

TZ_OFFSET_MINUTES=
ALLOW_PUBLIC_SIGNUP=
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
AUTH_RATE_MAX=30
API_RATE_MAX=600
# Per-IP limit (requests/minute) for the anonymous /api/public/* endpoints used by the Store.
PUBLIC_RATE_MAX=120
# Shop-scope guard: leave unset/1 (on). 0 only downgrades it to warnings while debugging.
ENFORCE_SHOP_SCOPE=1
