# MarketSuite Store — browser-exposed configuration ONLY.
# Anything prefixed with VITE_ is bundled into public JavaScript. Never put secrets here.

# API base URL of the shared management backend.
# Leave empty in development: Vite proxies /api to http://localhost:5000 (see vite.config.ts).
# In production set it to the deployed API, e.g. https://api.example.com/api
VITE_API_URL=

# Optional: link shown in the footer for shop owners (the management portal URL).
VITE_PORTAL_URL=
